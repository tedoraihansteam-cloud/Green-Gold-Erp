# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=green_gold_erp
PGUSER=postgres
PGPASSWORD=change_me

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# QR code signing (used to sign the hash embedded in every QR code)
QR_SIGNING_SECRET=change_this_to_a_different_long_random_string

# Base URL used inside QR codes for API lookup (optional)
APP_BASE_URL=http://localhost:4000

# Expenses at or below this amount auto-approve and post immediately;
# above it, they wait for someone with ACCOUNTS_APPROVE to review them.
EXPENSE_AUTO_APPROVE_THRESHOLD=5000

# --- Only used by `docker-compose up` (docker-entrypoint.sh runs bootstrap
# automatically on container start, using these) ---
APP_PORT=4000
BOOTSTRAP_COMPANY_NAME=Green Gold Agro Products Ltd
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_this_before_first_start
